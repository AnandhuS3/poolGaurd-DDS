# ============================================================================
# CREDENTIALS TEMPLATE - Safe to commit to Git
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# This is a template file showing what credentials are needed

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ============================================================================
# EMAIL CREDENTIALS (SMTP)
# ============================================================================
# Gmail App Password Instructions:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Sign in to your Google account
# 3. Create a new app password (select "Mail" and your device)
# 4. Copy the 16-character password and paste below

SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here

# ============================================================================
# SMS/WHATSAPP CREDENTIALS (Twilio)
# ============================================================================
# Get your credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# ============================================================================
# NOTIFICATION RECIPIENTS
# ============================================================================
# Comma-separated list of email addresses or phone numbers
# Example: user1@example.com,user2@example.com
NOTIFICATION_RECIPIENTS=user@example.com,admin@example.com
