# ============================================================================
# CREDENTIALS FILE EXAMPLE
# ============================================================================
# Do NOT commit the real .env file. Use this as a template.

# DATABASE CREDENTIALS
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poolguard_db

# SECURITY / JWT
# Generate securely in production via: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET

# SERVER SETTINGS
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-frontend.com

# APP CONFIGURATION
APP_BASE_URL=https://your-production-frontend.com

# FIREBASE CONFIGURATION
FIREBASE_SA_PATH=/app/backend/config/firebase-sa.json

# EMAIL CREDENTIALS (SMTP)
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS/WHATSAPP CREDENTIALS (Twilio) - Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# NOTIFICATION RECIPIENTS (Comma-separated)
NOTIFICATION_RECIPIENTS=
