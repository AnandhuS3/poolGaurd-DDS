# ============================================================================
# CREDENTIALS TEMPLATE — Safe to commit to Git
# ============================================================================
# 1. Copy this file:  cp backend/config/.env.example backend/config/.env
# 2. Fill in every value marked  <CHANGE_ME>
# 3. Never commit the filled-in .env  (it is listed in .gitignore)

# ============================================================================
# DATABASE CREDENTIALS  (MySQL)
# ============================================================================
DB_USER=root
DB_PASSWORD=<CHANGE_ME>

# ============================================================================
# SECURITY / JWT
# ============================================================================
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=<CHANGE_ME>

# ============================================================================
# SERVER SETTINGS
# ============================================================================
HOST=0.0.0.0
PORT=8000
# Set to true ONLY during local development; never true in production
DEBUG=false

# ============================================================================
# CORS — Allowed Frontend Origins
# ============================================================================
# Comma-separated list of allowed origins (no trailing slashes)
# Dev example:     ALLOWED_ORIGINS=http://localhost:5173
# Prod example:    ALLOWED_ORIGINS=https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================================
# EMAIL CREDENTIALS  (SMTP / Gmail App Password)
# ============================================================================
# Gmail App Password instructions:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Create a new app password → select "Mail" + your device
# 3. Paste the 16-character password below
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=<CHANGE_ME>

# ============================================================================
# APP CONFIGURATION
# ============================================================================
# Base URL of the frontend app — used in email verification / reset links
APP_BASE_URL=https://your-domain.com

# ============================================================================
# NOTIFICATION RECIPIENTS
# ============================================================================
# Comma-separated list of email addresses that receive drowning alerts
NOTIFICATION_RECIPIENTS=guard@example.com,admin@example.com
